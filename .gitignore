# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 虚拟环境（体积大，随仓库分发无意义；接收方跑 install.bat 自建）----
venv/

# ---- 本地运行数据（作品索引 / 缩略图 / 元数据 / 日志）----
archive.db
archive.db-wal
archive.db-shm
# 数据迁移：导入前的库快照备份，以及导出快照 / 导入暂存目录
archive.db.bak-*
.pa-snapshot-*.db
.pa-import-*/
thumbnails/
metadata/
*.log
pixiv_archive_check.txt
.instance.lock
# 锁接管临时文件：rename 到 .stale.<pid>.<uuid> 后被强杀会残留
*.stale.*

# ---- 用户配置（含 refresh token 等机密，切勿提交）----
.env

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 本仓库自用：审查/临时产物 ----
.removed-backup/
.qa-tmp/
# 内部工作产物（代码审查 / 安全审计 / QA 报告），不随仓库分发
deliverables/
CODE_REVIEW.md

# ---- AI 工作区（本地工具状态，非项目源码）----
.workbuddy-ai/

# ---- 测试运行产物（tests/run_all.py 的输出日志与截图；*.log 已覆盖，这里再明确一次）----
tests/_*.log
tests/_*.png