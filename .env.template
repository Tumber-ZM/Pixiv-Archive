# Pixiv Archive 环境变量模板
# install.bat 首次运行时会把它复制成 .env；也可以自己复制后按需修改。
# 值不需要加引号，行尾不要写注释。

# ── 必需 ──────────────────────────────────────────────────────
# 本地已下载的 Pixiv 图片目录（扫描入库的来源）
IMAGE_SOURCE_DIR=D:\Pixiv

# Pixiv refresh token：同步元数据、收藏订阅下载都需要
PIXIV_REFRESH_TOKEN=

# ── 网络 ──────────────────────────────────────────────────────
# 连接方式：auto（默认，直连优先、失败回退代理）/ direct（免 SNI 直连）/ proxy
PIXIV_MODE=auto

# 代理地址（PIXIV_MODE=proxy 时使用），例如 http://127.0.0.1:7890
PIXIV_PROXY=

# 直连模式使用的 Pixiv IP；留空则由程序通过 DoH 解析并自动回填
PIXIV_IP_APP_API=
PIXIV_IP_OAUTH=
PIXIV_IP_IMAGE=
PIXIV_IP_STATIC=

# 第三方图片镜像域名（留空使用官方 i.pximg.net）
PIXIV_IMAGE_MIRROR=

# ── 本地服务 ──────────────────────────────────────────────────
# 服务端口（固定绑定 127.0.0.1，仅本机可访问）
PA_PORT=6814

# ── 性能与限速 ────────────────────────────────────────────────
# 缩略图长边像素
THUMBNAIL_SIZE=400

# 缩略图 / 元数据目录名（一般不需要改）
THUMBNAIL_DIR=thumbnails
METADATA_DIR=metadata

# 同步与下载之间的等待毫秒数，用于防风控；0 表示不限速
SYNC_DELAY_MS=800